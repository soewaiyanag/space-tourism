---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/data.json";
import type { Technology } from "../types";
import { base } from "../lib/base";

const technology = data.technology as Technology[];
const first = technology[0];
---

<BaseLayout
  title="Technology"
  description="The technology that gets you to space. Learn about the launch vehicle, spaceport, and space capsule."
  current="technology"
  bg="technology"
>
  <div class="flex flex-col items-start gap-8 py-6 md:py-10 lg:py-12">
    <h1 class="flex w-full items-start justify-center gap-6 px-6 font-condensed uppercase tracking-[2.4px] text-white md:justify-start md:px-10 md:tracking-[3px] lg:justify-start lg:px-16 lg:tracking-[4px]">
      <span class="text-[16px] font-bold text-white/25 md:text-[20px] lg:text-[28px]" aria-hidden="true">03</span>
      <span class="text-[16px] md:text-[20px] lg:text-[28px]">Space launch 101</span>
    </h1>

    <div class="flex w-full flex-1 flex-col items-center gap-8 lg:flex-row lg:items-center lg:gap-16">
      <img
        id="technology-image"
        class="order-1 h-[240px] w-full object-cover md:h-[360px] lg:order-2 lg:h-[600px] lg:flex-1 lg:self-stretch"
        src={`${base}${first.images.landscape}`}
        alt={`${first.name}, launch photo`}
      />

      <div class="order-2 flex w-full flex-col items-center gap-10 px-6 md:px-10 lg:order-1 lg:min-w-[635px] lg:flex-1 lg:flex-row lg:items-center lg:gap-16 lg:px-16">
        <div
          role="tablist"
          aria-label="Technology"
          id="technology-tabs"
          class="flex cursor-pointer items-center gap-4 md:gap-4 lg:flex-col lg:gap-8"
        >
          {
            technology.map((_, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${i}`}
                aria-controls="technology-panel"
                aria-selected={i === 0}
                aria-label={`Technology ${i + 1}`}
                tabindex={i === 0 ? 0 : -1}
                class:list={[
                  "grid size-10 shrink-0 place-items-center rounded-full border font-bellefair text-lg uppercase leading-none transition-colors md:size-14 md:text-2xl lg:size-20 lg:text-[32px]",
                  i === 0
                    ? "border-white bg-white text-primary"
                    : "border-white/25 text-white hover:border-white",
                ]}
              >
                {i + 1}
              </button>
            ))
          }
        </div>

        <div
          id="technology-panel"
          role="tabpanel"
          aria-labelledby="tab-0"
          class="flex max-w-[512px] flex-col items-center gap-4 text-center lg:max-w-[640px] lg:items-start lg:text-left"
        >
          <div class="flex flex-col items-center gap-2 font-bellefair uppercase text-white lg:items-start">
            <p class="text-lg leading-none text-white/50 md:text-2xl lg:text-[32px]">
              The terminology&hellip;
            </p>
            <h2 id="name" class="text-2xl leading-none md:text-[40px] lg:text-[56px]">
              {first.name}
            </h2>
          </div>
          <p id="description" class="text-[15px] leading-[1.8] text-secondary md:text-base lg:text-lg">
            {first.description}
          </p>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initTablist } from "../scripts/tablist";
    import data from "../data/data.json";
    import type { Technology } from "../types";
    import { base } from "../lib/base";

    const technology = data.technology as Technology[];

    const tablist = document.getElementById("technology-tabs");
    if (tablist) {
      const image = document.getElementById("technology-image") as HTMLImageElement;
      const name = document.getElementById("name")!;
      const description = document.getElementById("description")!;
      const panel = document.getElementById("technology-panel")!;
      const tabs = Array.from(
        tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );

      const render = (index: number): void => {
        const item = technology[index];
        image.src = `${base}${item.images.landscape}`;
        image.alt = `${item.name}, launch photo`;
        name.textContent = item.name;
        description.textContent = item.description;
        panel.setAttribute("aria-labelledby", tabs[index].id);
        tabs.forEach((tab, i) => {
          const active = i === index;
          tab.classList.toggle("bg-white", active);
          tab.classList.toggle("text-primary", active);
          tab.classList.toggle("border-white", active);
          tab.classList.toggle("text-white", !active);
          tab.classList.toggle("border-white/25", !active);
        });
      };

      initTablist(tablist, render);
    }
  </script>
</BaseLayout>
