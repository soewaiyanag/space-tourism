---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/data.json";
import type { CrewMember } from "../types";
import { base } from "../lib/base";

const crew = data.crew as CrewMember[];
const first = crew[0];
---

<BaseLayout
  title="Crew"
  description="Meet your crew. Get to know the team you'll be flying with."
  current="crew"
  bg="crew"
>
  <div class="flex flex-col items-start gap-6 p-6 md:p-10 lg:px-16 lg:py-12">
    <h1 class="flex w-full items-start justify-center gap-6 font-condensed uppercase tracking-[2.4px] text-white md:justify-start md:tracking-[3px] lg:justify-start lg:tracking-[4px]">
      <span class="text-[16px] font-bold text-white/25 md:text-[20px] lg:text-[28px]" aria-hidden="true">02</span>
      <span class="text-[16px] md:text-[20px] lg:text-[28px]">Meet your crew</span>
    </h1>

    <div
      class="
        flex w-full flex-1 flex-col items-center gap-8
        md:gap-8
        lg:mx-auto lg:max-w-[1110px] lg:flex-row lg:items-stretch lg:gap-8
      "
    >
      <div class="order-2 flex w-full max-w-[512px] flex-col items-start gap-10 lg:order-1 lg:max-w-none lg:flex-1 lg:justify-center">
        <div
          id="crew-panel"
          role="tabpanel"
          aria-labelledby="tab-0"
          class="flex w-full max-w-[640px] flex-col items-center gap-6 pt-10 text-center lg:items-start lg:pt-0 lg:text-left"
        >
          <div class="flex flex-col items-center gap-2 text-center uppercase lg:items-start lg:text-left">
            <p id="role" class="font-bellefair text-lg leading-none text-white/50 md:text-2xl lg:text-[32px]">
              {first.role}
            </p>
            <h2 id="name" class="font-bellefair text-2xl leading-none text-white md:text-[40px] lg:text-[56px]">
              {first.name}
            </h2>
          </div>
          <p id="bio" class="text-[15px] leading-[1.8] text-secondary md:text-base lg:text-lg">
            {first.bio}
          </p>
        </div>

        <div
          role="tablist"
          aria-label="Crew members"
          id="crew-tabs"
          class="flex w-full cursor-pointer items-center justify-center gap-4 lg:justify-start lg:gap-10"
        >
          {
            crew.map((member, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${i}`}
                aria-controls="crew-panel"
                aria-selected={i === 0}
                aria-label={member.name}
                tabindex={i === 0 ? 0 : -1}
                class:list={[
                  "size-[10px] shrink-0 rounded-full transition-colors lg:size-[15px]",
                  i === 0 ? "bg-white" : "bg-white/25",
                ]}
              />
            ))
          }
        </div>
      </div>

      <div class="order-1 flex w-full items-end justify-center lg:order-2 lg:flex-1">
        <img
          id="crew-img"
          class="h-[340px] w-auto object-contain object-bottom transition-opacity md:h-[560px] lg:h-[676px]"
          src={`${base}${first.images.png}`}
          alt={`${first.name}, ${first.role}`}
        />
      </div>
    </div>
  </div>

  <script>
    import { initTablist } from "../scripts/tablist";
    import data from "../data/data.json";
    import type { CrewMember } from "../types";
    import { base } from "../lib/base";

    const crew = data.crew as CrewMember[];

    const tablist = document.getElementById("crew-tabs");
    if (tablist) {
      const img = document.getElementById("crew-img") as HTMLImageElement;
      const name = document.getElementById("name")!;
      const role = document.getElementById("role")!;
      const bio = document.getElementById("bio")!;
      const panel = document.getElementById("crew-panel")!;
      const tabs = Array.from(
        tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );

      const render = (index: number): void => {
        const member = crew[index];
        img.src = `${base}${member.images.png}`;
        img.alt = `${member.name}, ${member.role}`;
        name.textContent = member.name;
        role.textContent = member.role;
        bio.textContent = member.bio;
        panel.setAttribute("aria-labelledby", tabs[index].id);
        tabs.forEach((tab, i) => {
          tab.classList.toggle("bg-white", i === index);
          tab.classList.toggle("bg-white/25", i !== index);
        });
      };

      initTablist(tablist, render);
    }
  </script>
</BaseLayout>
