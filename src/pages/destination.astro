---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/data.json";
import type { Destination } from "../types";
import { base } from "../lib/base";

const destinations = data.destinations as Destination[];
const first = destinations[0];
---

<BaseLayout
  title="Destination"
  description="Choose your destination. Here are some of the most exciting locations you can visit around our solar system."
  current="destination"
  bg="destination"
>
  <div class="flex flex-col items-start gap-6 p-6 md:p-10 lg:px-16 lg:py-12">
    <h1 class="flex items-start gap-6 font-condensed uppercase tracking-[2.4px] text-white md:tracking-[3px] lg:tracking-[4px] w-full justify-center md:justify-start">
      <span class="text-[16px] font-bold text-white/25 md:text-[20px] lg:text-[28px]" aria-hidden="true">01</span>
      <span class="text-[16px] md:text-[20px] lg:text-[28px]">Pick your destination</span>
    </h1>

    <div
      class="
        flex w-full flex-1 flex-col items-center justify-center gap-8
        md:gap-8
        lg:w-full lg:max-w-[1110px] lg:mx-auto lg:flex-row lg:items-center lg:gap-8
      "
    >
      <div class="flex items-center justify-center lg:flex-1">
        <img
          id="planet-pic"
          class="size-[150px] transition-opacity md:size-[300px] lg:size-[480px]"
          src={`${base}${first.images.png}`}
          alt={first.name}
        />
      </div>

      <div class="flex flex-1 flex-col items-center gap-10 lg:min-w-[445px] lg:items-start lg:justify-center">
        <div class="flex w-full max-w-[445px] flex-col items-center gap-6 lg:items-start">
          <div
            role="tablist"
            aria-label="Destinations"
            id="destination-tabs"
            class="flex cursor-pointer gap-8 font-condensed uppercase text-secondary"
          >
            {
              destinations.map((d, i) => (
                <button
                  type="button"
                  role="tab"
                  id={`tab-${d.name.toLowerCase()}`}
                  aria-controls="destination-panel"
                  aria-selected={i === 0}
                  tabindex={i === 0 ? 0 : -1}
                  class:list={[
                    "select-none border-b-3 pb-2 text-sm tracking-[2.1px] leading-none md:text-base md:tracking-[2px] lg:text-base",
                    i === 0 ? "border-white text-white" : "border-transparent",
                  ]}
                >
                  {d.name}
                </button>
              ))
            }
          </div>

          <div
            id="destination-panel"
            role="tabpanel"
            aria-labelledby={`tab-${first.name.toLowerCase()}`}
            class="flex w-full flex-col items-center gap-6 text-center lg:items-start lg:text-left"
          >
            <div class="flex w-full flex-col items-center gap-4 text-center lg:items-start lg:text-left">
              <h2
                id="planet-name"
                class="font-bellefair text-[56px] uppercase leading-none text-white transition-opacity md:text-[80px] lg:text-[96px]"
              >
                {first.name}
              </h2>
              <p
                id="about-planet"
                class="text-[15px] leading-[1.8] text-secondary transition-opacity md:text-base lg:text-lg"
              >
                {first.description}
              </p>
            </div>

            <div class="h-px w-full bg-white/25" aria-hidden="true"></div>

            <div
              class="
                flex w-full flex-col items-center gap-6 text-center uppercase
                md:flex-row md:items-start md:gap-6 md:text-left
                lg:flex-row lg:items-start lg:gap-6 lg:text-left
              "
            >
              <div class="flex flex-1 flex-col items-center gap-3 md:items-start lg:items-start">
                <p class="font-condensed text-sm tracking-[2px] text-secondary">avg. distance</p>
                <p
                  id="travel-distance"
                  class="font-bellefair text-[28px] uppercase leading-none text-white transition-opacity"
                >
                  {first.distance}
                </p>
              </div>
              <div class="flex flex-1 flex-col items-center gap-3 md:items-start lg:items-start">
                <p class="font-condensed text-sm tracking-[2px] text-secondary">est. travel time</p>
                <p
                  id="travel-time"
                  class="font-bellefair text-[28px] uppercase leading-none text-white transition-opacity"
                >
                  {first.travel}
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { initTablist } from "../scripts/tablist";
    import data from "../data/data.json";
    import type { Destination } from "../types";
    import { base } from "../lib/base";

    const destinations = data.destinations as Destination[];

    const tablist = document.getElementById("destination-tabs");
    if (tablist) {
      const planetPic = document.getElementById("planet-pic") as HTMLImageElement;
      const planetName = document.getElementById("planet-name")!;
      const aboutPlanet = document.getElementById("about-planet")!;
      const travelDistance = document.getElementById("travel-distance")!;
      const travelTime = document.getElementById("travel-time")!;
      const panel = document.getElementById("destination-panel")!;
      const tabs = Array.from(
        tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
      );

      const render = (index: number): void => {
        const d = destinations[index];
        planetPic.src = `${base}${d.images.png}`;
        planetPic.alt = d.name;
        planetName.textContent = d.name;
        aboutPlanet.textContent = d.description;
        travelDistance.textContent = d.distance;
        travelTime.textContent = d.travel;
        panel.setAttribute("aria-labelledby", tabs[index].id);
        tabs.forEach((tab, i) => {
          tab.classList.toggle("border-white", i === index);
          tab.classList.toggle("text-white", i === index);
          tab.classList.toggle("border-transparent", i !== index);
        });
      };

      initTablist(tablist, render);
    }
  </script>
</BaseLayout>
