---
import Nav from "../components/Nav.astro";
import { base } from "../lib/base";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current: "home" | "destination" | "crew" | "technology";
  bg: "home" | "destination" | "crew" | "technology";
}

const { title, description, current, bg } = Astro.props;

const bgClasses: Record<Props["bg"], string> = {
  home: "bg-home-mobile md:bg-home-tablet lg:bg-home-desktop",
  destination: "bg-destination-mobile md:bg-destination-tablet lg:bg-destination-desktop",
  crew: "bg-crew-mobile md:bg-crew-tablet lg:bg-crew-desktop",
  technology: "bg-technology-mobile md:bg-technology-tablet lg:bg-technology-desktop",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${base}assets/favicon-32x32.png`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bellefair&family=Barlow:wght@400&family=Barlow+Condensed:wght@400;700&display=swap"
      rel="stylesheet"
    />
    <title>{title} | Space tourism</title>
  </head>
  <body
    class:list={[
      "flex min-h-screen flex-col bg-black bg-no-repeat bg-cover bg-center bg-fixed text-white",
      bgClasses[bg],
    ]}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:text-primary focus:px-4 focus:py-2 focus:rounded"
    >
      Skip to content
    </a>

    <Nav current={current} />

    <main id="main" class="flex flex-1 flex-col overflow-x-hidden">
      <slot />
    </main>
  </body>
</html>
